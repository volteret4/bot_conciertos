[Unit]
Description=Telegram Bot Conciertos
After=network.target

[Service]
Type=simple
User=pepe
WorkingDirectory=/home/usuario/gits/pollo/bot_conciertos/
EnvironmentFile=/home/usuario/gits/pollo/bot_conciertos/.env
ExecStart=/home/usuario/Scripts/python_venv/bin/python /home/usuario/gits/pollo/bot_conciertos/telegram_bot.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
