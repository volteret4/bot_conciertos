# Copia este fichero a .env y rellénalo.

# Obligatorias
TELEGRAM_BOT_CONCIERTOS=
TICKETMASTER_API_KEY=
LASTFM_API_KEY=

# Opcionales
SETTINGS_PASSWORD=
COUNTRY_CITY_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
GENIUS_API_KEY=
DISCOGS_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Avisos de conciertos que llegan por correo (trabajo bot-conciertos-email-scan)
IMAP_SERVER=
IMAP_PORT=993
IMAP_EMAIL=
IMAP_PASSWORD=
# Calendario CalDAV (Radicale u otro)
RADICALE_URL=
RADICALE_USERNAME=
RADICALE_PASSWORD=
RADICALE_CALENDAR=
# Bot de administración (avisos de errores)
ADMIN_BOT_TOKEN=
ADMIN_CHAT_ID=

# ── docker-compose.yml ──────────────────────────────────────────
# Uid:gid del usuario dueño de esta carpeta (los ficheros que se generan son suyos)
UID_GID=1000:1000
# Zona horaria de los trabajos programados (Ofelia)
TZ=Europe/Madrid
